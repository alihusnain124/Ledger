# Required — transcription. Free key: https://console.groq.com
GROQ_API_KEY=

# Required — claim extraction + fact-check reasoning. Free key: https://openrouter.ai
OPENROUTER_API_KEY=

# Optional — grounds fact-checks in live search results instead of the model's
# own memory (much more reliable). Free tier: https://tavily.com
TAVILY_API_KEY=

# Optional overrides if the default free model IDs below go stale.
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
